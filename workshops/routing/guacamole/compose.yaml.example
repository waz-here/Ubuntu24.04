services:
  guacd:
    image: guacamole/guacd:1.6.0
    restart: unless-stopped
    network_mode: host

  guacamole:
    image: guacamole/guacamole:1.6.0
    restart: unless-stopped
    depends_on:
      - guacd
    environment:
      GUACD_HOSTNAME: host.docker.internal
      GUACD_PORT: 4822
      GUACAMOLE_HOME: /etc/guacamole
      WEBAPP_CONTEXT: ROOT
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./config:/etc/guacamole:ro
    ports:
      - "127.0.0.1:8080:8080"
